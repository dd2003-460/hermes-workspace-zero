memory/notes/subbrain_*.md

# Temporary files
*.tmp
*~

# Python virtual environments
venv/
**/venv/
.env/
**/.env/

# Node modules (6200 files, 72% of repo — never track)
node_modules/
**/node_modules/

# Large binary caches (Binance klines, funding data)
cache/
**/cache/
*.parquet
*.zip

