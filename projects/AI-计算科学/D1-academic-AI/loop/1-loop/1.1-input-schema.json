{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "1-loop Task Input",
  "description": "1-loop 任务输入的标准格式",
  "type": "object",
  "required": ["task_description"],
  "properties": {
    "task_description": {
      "type": "string",
      "description": "任务描述 - 要完成什么"
    },
    "context": {
      "type": "string",
      "description": "相关背景信息"
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "description": "限制条件列表"
    },
    "priority": {
      "type": "string",
      "enum": ["planning", "immediate"],
      "default": "planning",
      "description": "执行优先级"
    },
    "source": {
      "type": "string",
      "enum": ["user", "self_initiated", "loop_continuation"],
      "description": "任务来源"
    }
  }
}
