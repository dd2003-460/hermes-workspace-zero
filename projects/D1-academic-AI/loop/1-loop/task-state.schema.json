{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "1-loop Task State",
  "description": "1-loop 任务状态的标准格式——每轮必须写回",
  "type": "object",
  "required": ["iteration", "phase", "input", "output", "next_action"],
  "properties": {
    "iteration": {
      "type": "integer",
      "description": "1-loop 迭代次数"
    },
    "phase": {
      "type": "string",
      "enum": ["clarification", "information_gathering", "decomposition", "verification", "decision"],
      "description": "当前阶段"
    },
    "input": {
      "$ref": "#/definitions/task-input",
      "description": "当前轮次的输入"
    },
    "output": {
      "$ref": "#/definitions/task-output",
      "description": "当前轮次的输出"
    },
    "novelty_assessment": {
      "type": "string",
      "enum": ["N0", "N1", "N2", "N3"],
      "description": "新颖性评级"
    },
    "literature_cache_path": {
      "type": "string",
      "description": "文献检索缓存文件路径"
    },
    "tool_inventory": {
      "type": "array",
      "items": {"type": "string"},
      "description": "任务所需工具列表"
    },
    "gap_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {"type": "string"},
          "status": {"type": "string", "enum": ["complete", "partial", "missing"]},
          "impact": {"type": "string", "enum": ["high", "medium", "low"]},
          "action": {"type": "string"}
        }
      },
      "description": "缺失项分析"
    },
    "next_action": {
      "type": "string",
      "description": "下一步动作"
    },
    "decision": {
      "type": "string",
      "enum": ["continue_1loop", "enter_2loop"],
      "description": "是否进入执行"
    },
    "subtasks": {
      "type": "array",
      "description": "分解后的子任务列表"
    },
    "average_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "任务包平均置信度"
    }
  },
  "definitions": {
    "task-input": {
      "type": "object",
      "properties": {
        "description": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"}
      }
    },
    "task-output": {
      "type": "object",
      "properties": {
        "summary": {"type": "string"},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "working_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
