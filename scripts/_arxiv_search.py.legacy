#!/usr/bin/env python3
"""Literature search for research papers.
Usage: _arxiv_search.py <query> [max_results]

Searches arXiv for relevant papers using the arxiv Python package.
Outputs structured results for paper citation/reference.
"""
import sys

def main():
    query = " ".join(sys.argv[1:-1]) if len(sys.argv) > 2 and sys.argv[-1].isdigit() else " ".join(sys.argv[1:])
    max_results = int(sys.argv[-1]) if len(sys.argv) > 2 and sys.argv[-1].isdigit() else 5

    try:
        import arxiv
        client = arxiv.Client()
        search = arxiv.Search(query=query, max_results=max_results)
    except Exception as e:
        print(f"ERROR: {e}")
        sys.exit(1)

    results = []
    try:
        for result in client.results(search):
            results.append({
                "title": result.title.replace("\n", " ").strip(),
                "summary": result.summary.replace("\n", " ").strip(),
                "published": str(result.published),
                "categories": result.categories,
                "authors": [a.name for a in result.authors],
                "arxiv_id": result.get_arxiv_id()
            })
    except Exception as e:
        print(f"ERROR: {e}")
        sys.exit(1)

    if not results:
        print("No results found.")
        sys.exit(1)

    for i, r in enumerate(results, 1):
        print(f"\n[{i}/{len(results)}] {r.get_arxiv_id()} [{r['published'][:10]}]")
        print(f"Title: {r['title'][:120]}")
        print(f"Authors: {', '.join(r['authors'][:3])}")
        print(f"Categories: {', '.join(r['categories'][:3])}")
        print(f"Abstract: {r['summary'][:400]}")

    # JSON output for programmatic use
    print(f"\n---JSON---")
    import json
    print(json.dumps(results, indent=2, ensure_ascii=False))

if __name__ == "__main__":
    main()
