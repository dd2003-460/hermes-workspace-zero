#!/usr/bin/env python3
"""Extract title from .tex file, stripping LaTeX formatting commands."""
import re
import sys

def extract_braced_content(content, cmd):
    """Extract content of \\cmd{...} with balanced brace matching."""
    pattern = r'\\' + cmd + r'\{'
    m = re.search(pattern, content)
    if not m:
        return None
    start = m.end()
    depth = 1
    i = start
    while i < len(content) and depth > 0:
        if content[i] == '{':
            depth += 1
        elif content[i] == '}':
            depth -= 1
        i += 1
    return content[start:i-1] if depth == 0 else None

def strip_formatting(s):
    """Remove LaTeX formatting, keeping only bare text."""
    # Remove balanced \cmd{...} and keep content
    for cmd in ('textbf', 'textit', 'texttt', 'emph'):
        while True:
            m = re.search(rf'\\{cmd}\{{', s)
            if not m:
                break
            # Find the matching closing brace
            start = m.end()
            depth = 1
            j = start
            while j < len(s) and depth > 0:
                if s[j] == '{':
                    depth += 1
                elif s[j] == '}':
                    depth -= 1
                j += 1
            inner = s[start:j-1]
            s = s[:m.start()] + inner + s[j:]
    # Remove remaining formatting
    s = re.sub(r'\\vspace\{[^}]*\}', '', s)
    s = re.sub(r'\\text\{([^}]*)\}', r'\1', s)
    s = re.sub(r'\\linebreak.*', '', s)
    # Clean up specials
    s = s.replace('---', '--').replace('--', '-')
    s = re.sub(r'\\\\', ' ', s)
    s = re.sub(r'[{}\n\r\t]', ' ', s)
    s = re.sub(r'\s{2,}', ' ', s)
    return s.strip()[:80]

def main():
    tex_file = sys.argv[1] if len(sys.argv) > 1 else sys.stdin.read().strip()
    with open(tex_file, 'r', encoding='utf-8', errors='replace') as f:
        content = f.read()
    # Try \title{...} first (standard LaTeX)
    title = extract_braced_content(content, 'title')
    if title:
        print(strip_formatting(title))
        return
    # Fallback 1: look for English title pattern (pandoc ctexart)
    m = re.search(r'英文标题[}:]\s*(.+?)(?:\n|\n\textbf|$)', content)
    if m:
        title_text = m.group(1).strip().lstrip(': ').rstrip(':').strip()[:80]
        print(title_text)
        return
    # Fallback 2: first section heading
    first_sec = re.search(r'\\section\{(.*?)\}', content)
    if first_sec:
        print(strip_formatting(first_sec.group(1)))
        return
    print('UNKNOWN')

if __name__ == '__main__':
    main()
